{
  "name": "douyudm",
  "version": "3.2.0",
  "description": "实时获取斗鱼弹幕",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "browser": "dist/douyudm.browser.min.js",
  "types": "dist/types/index.d.ts",
  "bin": {
    "douyudm": "dist/cli/cmd.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "browser": "./dist/douyudm.browser.min.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": {
    "name": "flxxyz",
    "email": "i@mdzz.name"
  },
  "license": "MIT",
  "keywords": [
    "douyu",
    "danmu",
    "斗鱼",
    "弹幕",
    "stt",
    "serialize",
    "deserialize",
    "序列化",
    "typescript"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flxxyz/douyudm.git"
  },
  "bugs": {
    "url": "https://github.com/flxxyz/douyudm/issues"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "playwright": "1.56.1",
    "rollup": "^4.55.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript": "^7.0.5",
      "@babel/core": "^7.29.6",
      "brace-expansion@1": "^1.1.13",
      "js-yaml@3": "^3.15.0"
    }
  },
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript && tsc --emitDeclarationOnly --outDir dist/types",
    "test": "jest",
    "test:stt": "jest __tests__/stt.test.ts",
    "test:packet": "jest __tests__/packet.test.ts",
    "test:ports": "jest __tests__/ports.live.test.ts --testPathIgnorePatterns=/node_modules/",
    "test:entrypoints": "npm run build && node --test __tests__/entrypoints.test.cjs",
    "test:browser": "npm run build && node --test __tests__/browser.live.cjs",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build"
  }
}
